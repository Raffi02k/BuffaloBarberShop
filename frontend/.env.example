# Frontend values are PUBLIC. Never store secrets in VITE_* variables.
# A production domain is not confirmed; indexation stays disabled.
VITE_SITE_URL=https://example.invalid
VITE_INDEXABLE=false
VITE_CONTENT_APPROVED=false
VITE_API_BASE_URL=
# Local-only Vite proxy target, NOT exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
VITE_KENAIS_BOOKING_URL=
VITE_HERO_VIDEO=/media/barber-story-demo.mp4
VITE_REVIEWS_API_URL=
# Complete, owner-approved contact details only.
VITE_PHONE=
VITE_EMAIL=
